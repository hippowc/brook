#!/usr/bin/env bash
# brook —— GitHub release 二进制安装器
# 子命令用法见 brook help；工具映射在 registry/，配置钩子在 hooks/。
set -euo pipefail
# 解析符号链接（brook 通过 ~/.local/bin/brook 软链调用时，BASH_SOURCE 指向链接位置）
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
BROOK_HOME="$(cd "$(dirname "$_src")" && pwd)"
export BROOK_HOME
export BROOK_BIN_DIR="${BROOK_BIN_DIR:-$HOME/.local/bin}"
export BROOK_META_DIR="${BROOK_META_DIR:-$BROOK_BIN_DIR/.brook-meta}"
source "$BROOK_HOME/lib/core.sh"
source "$BROOK_HOME/lib/proxy.sh"
source "$BROOK_HOME/lib/registry.sh"
source "$BROOK_HOME/lib/official.sh"
brook_main "$@"
