# 模型后端定义 —— 适配器的单一事实源
# bailian（阿里百炼）是 OpenAI 兼容端点；OpenAI 兼容是开源 agent 的最大公约数，
# 换后端 = 新增一个 *.env（如 openrouter.env / ollama.env），适配器无需改动。
PROVIDER_NAME="bailian"
PROVIDER_BASE_URL="https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
PROVIDER_MODEL="qwen3.8-max-preview"
PROVIDER_KEY_ENV="OPENAI_API_KEY"
PROVIDER_WIRE_API="responses"   # codex 用 responses；多数 agent 用 chat
